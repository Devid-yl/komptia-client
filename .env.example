# =====================================================================
# Variables d'environnement Komptia
# Copier ce fichier en .env et remplir les valeurs.
# Le .env contient des SECRETS — ne JAMAIS le commiter (déjà gitignoré).
# =====================================================================

# Environnement
ENVIRONMENT=production
DEBUG=false

# =====================================================================
# Déploiement derrière un reverse-proxy HTTPS (nginx) — À RENSEIGNER en prod
# =====================================================================
# Origines autorisées pour les WebSockets d'aperçu d'automatisation.
# CSV des origines EXACTES (schéma + hôte, SANS slash final) par lesquelles
# les utilisateurs accèdent à Komptia, p.ex. :
#   KOMPTIA_ALLOWED_ORIGINS=https://komptia.client.fr
#   KOMPTIA_ALLOWED_ORIGINS=https://192.168.1.10,https://komptia.lan
#
# /!\ En ENVIRONMENT=production, si cette variable est VIDE, le WebSocket
#     d'aperçu d'automatisation (/ws/automations/<id>/preview) REFUSE toute
#     connexion (fail-closed, anti-CSRF WebSocket) — l'aperçu ne fonctionnera
#     pas tant qu'elle n'est pas renseignée. (En dev/test, vide = le contrôle
#     retombe sur le header Host.) Le chat Iris (/ws/iris) n'est PAS concerné.
KOMPTIA_ALLOWED_ORIGINS=

# =====================================================================
# Clé secrète des sessions
# =====================================================================
# Générer : python3 -c "import secrets; print(secrets.token_hex(32))"
# Conséquence si modifiée après init : tous les utilisateurs sont
# déconnectés (les sessions actives deviennent invalides).
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_RANDOM_STRING

# =====================================================================
# Clé de chiffrement de la BDD locale (SQLCipher)
# =====================================================================
# Générer : python3 -c "import secrets; print(secrets.token_hex(32))"
#
# /!\ CRITIQUE — À CONSERVER EN LIEU SÛR (gestionnaire de mots de passe,
#     coffre, clé USB chiffrée).
#     - Si cette clé est PERDUE, la BDD existante (et tous les backups)
#       sont DÉFINITIVEMENT illisibles.
#     - Si cette clé est CHANGÉE après l'init, la BDD existante n'est
#       plus déchiffrable. NE JAMAIS la modifier après installation.
SQLCIPHER_KEY=CHANGE_ME_USE_RANDOM_64_CHAR_HEX_STRING

# =====================================================================
# BDD source SQL Server (lecture seule)
# =====================================================================
# Komptia se connecte à une BDD SQL Server existante en lecture seule
# (jamais d'écriture sur la BDD source). Adapter les valeurs au
# logiciel comptable / ERP source utilisé chez le client.
SAGE_DB_HOST=serveur-sql.local
SAGE_DB_PORT=1433
SAGE_DB_NAME=ma_base
SAGE_DB_USER=komptia_readonly
SAGE_DB_PASSWORD=

# =====================================================================
# Provider LLM principal (Anthropic Claude par défaut)
# =====================================================================
# La clé peut aussi être configurée via /admin/ai-config dans l'app
# une fois connecté. Si vide ici, l'app demandera à l'admin au premier
# usage de l'agent IA.
ANTHROPIC_API_KEY=

# =====================================================================
# Serveur SMTP (envoi des rapports par email)
# =====================================================================
# Si SMTP_USER vide : l'app refuse l'envoi de mails (les rapports
# restent disponibles dans l'app, mais ne sont pas diffusés).
SMTP_HOST=smtp.exemple.local
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@exemple.local

# =====================================================================
# Bootstrap admin (optionnel — pour `make first-run` non-interactif)
# =====================================================================
# Si ces 3 variables sont définies, scripts/seed_admin créera le premier
# compte admin sans demander de saisie. Recommandé pour automatiser un
# déploiement scripté ; les LAISSER VIDES sinon (saisie interactive).
#
# /!\ KOMPTIA_ADMIN_PASSWORD : `make first-run` la PURGE automatiquement de ce
#     fichier après le seed (et recrée le conteneur), pour qu'elle ne reste pas
#     dans l'env du container — sinon visible via `docker inspect`. Si vous
#     seedez l'admin par un autre chemin, videz la valeur manuellement après usage
#     (helper : `sh scripts/scrub_dotenv_value.sh .env KOMPTIA_ADMIN_PASSWORD`).
KOMPTIA_ADMIN_USERNAME=
KOMPTIA_ADMIN_EMAIL=
KOMPTIA_ADMIN_PASSWORD=
