# =====================================================================
# Variables d'environnement Komptia
# Copier ce fichier en .env et remplir les valeurs.
# Le .env contient des SECRETS — ne JAMAIS le commiter (déjà gitignoré).
# =====================================================================

# Environnement
ENVIRONMENT=production
DEBUG=false

# =====================================================================
# Fuseau horaire — SOURCE DE VÉRITÉ de l'affichage des dates (prod)
# =====================================================================
# Komptia stocke tout en UTC et convertit à l'AFFICHAGE vers ce fuseau
# (clock.format_local_fr ← config.server.timezone ← TZ). Nom IANA :
# America/Guadeloupe, Europe/Paris, Indian/Reunion, UTC... À ADAPTER au
# lieu de déploiement. Si absent → UTC (les dates apparaîtraient en UTC,
# ex. +4h pour Guadeloupe qui est UTC−4). Honoré par docker-compose.
TZ=America/Guadeloupe

# =====================================================================
# Déploiement derrière un reverse-proxy HTTPS (nginx) — À RENSEIGNER en prod
# =====================================================================
# Origines autorisées pour les WebSockets d'aperçu d'automatisation.
# CSV des origines EXACTES (schéma + hôte, SANS slash final) par lesquelles
# les utilisateurs accèdent à Komptia, p.ex. :
#   KOMPTIA_ALLOWED_ORIGINS=https://komptia.client.fr
#   KOMPTIA_ALLOWED_ORIGINS=https://192.168.1.10,https://komptia.lan
#
# /!\ En ENVIRONMENT=production, si cette variable est VIDE, le WebSocket
#     d'aperçu d'automatisation (/ws/automations/<id>/preview) REFUSE toute
#     connexion (fail-closed, anti-CSRF WebSocket) — l'aperçu ne fonctionnera
#     pas tant qu'elle n'est pas renseignée. (En dev/test, vide = le contrôle
#     retombe sur le header Host.) Le chat Iris (/ws/iris) n'est PAS concerné.
KOMPTIA_ALLOWED_ORIGINS=

# =====================================================================
# Clé secrète des sessions
# =====================================================================
# Générer : python3 -c "import secrets; print(secrets.token_hex(32))"
# Conséquence si modifiée après init : tous les utilisateurs sont
# déconnectés (les sessions actives deviennent invalides).
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_RANDOM_STRING

# =====================================================================
# Clé de chiffrement de la BDD locale (SQLCipher)
# =====================================================================
# Générer : python3 -c "import secrets; print(secrets.token_hex(32))"
#
# /!\ CRITIQUE — À CONSERVER EN LIEU SÛR (gestionnaire de mots de passe,
#     coffre, clé USB chiffrée).
#     - Si cette clé est PERDUE, la BDD existante (et tous les backups)
#       sont DÉFINITIVEMENT illisibles.
#     - Si cette clé est CHANGÉE après l'init, la BDD existante n'est
#       plus déchiffrable. NE JAMAIS la modifier après installation.
# Format : secret aléatoire ≥ 32 caractères. Deux modes, détectés automatiquement :
#   - Clé hexadécimale de 64 (ou 96) caractères — le format de `openssl rand -hex 32`,
#     ce que `make first-run` génère — est utilisée comme clé AES-256 BRUTE (pas de
#     KDF : inutile sur 256 bits déjà aléatoires → ouverture de connexion instantanée).
#   - Toute autre passphrase est dérivée en clé AES-256 via PBKDF2 (256k itérations).
# `make first-run` la génère automatiquement si laissée à CHANGE_ME.
SQLCIPHER_KEY=CHANGE_ME_USE_RANDOM_PASSPHRASE_MIN_32_CHARS

# =====================================================================
# BDD source SQL Server — DEV / SCRIPTS STANDALONE uniquement
# =====================================================================
# /!\ En PRODUCTION, la connexion à la BDD source se configure DANS L'APP via
#     /admin/database (UNIQUE source de vérité, mot de passe chiffré Fernet).
#     La connexion de prod IGNORE ces variables : les renseigner ici ne configure
#     PAS l'app (l'exécution SQL reste refusée tant que /admin/database est vide).
# Elles ne servent qu'aux scripts standalone / dev (pipeline NL→SQL, recovery)
# et au mode SQLite local de test — en lecture seule sur la BDD source.
SAGE_DB_HOST=serveur-sql.local
SAGE_DB_PORT=1433
SAGE_DB_NAME=ma_base
SAGE_DB_USER=komptia_readonly
SAGE_DB_PASSWORD=

# Timeout de LOGIN ODBC (établissement de la connexion), en secondes — défaut 15.
# ⚠️ CONTRAIREMENT aux SAGE_DB_* ci-dessus (host/port/nom/user, IGNORÉES en prod
# car /admin/database fait foi), CE knob EST lu en prod : c'est un timeout
# d'infrastructure, pas une donnée de connexion. Il DOIT rester < au timeout de
# REQUÊTE configuré sur /admin/database (wall-clock) : sinon, quand Sage devient
# injoignable, le circuit breaker ne s'ouvre pas et CHAQUE requête pend jusqu'au
# gel total de l'app (incident prod 2026-06-08). 15 s = large pour un Sage
# joignable (<1 s) mais assez court pour fail-fast s'il est injoignable.
# À augmenter UNIQUEMENT si des connexions LÉGITIMES échouent (LAN très lent /
# handshake TLS ancien sur un Sage d'époque).
#SAGE_DB_CONNECT_TIMEOUT=15

# =====================================================================
# Provider LLM principal (Anthropic Claude par défaut)
# =====================================================================
# La clé peut aussi être configurée via /admin/ai-config dans l'app
# une fois connecté. Si vide ici, l'app demandera à l'admin au premier
# usage de l'agent IA.
ANTHROPIC_API_KEY=

# =====================================================================
# LLM local (Ollama) — OPTIONNEL, désactivé par défaut
# =====================================================================
# Active le sidecar Ollama AVEC la stack (profil compose `llm-local`). Docker
# Compose v2 lit COMPOSE_PROFILES depuis ce .env : avec la ligne ci-dessous
# décommentée, un simple `make up` / `make update` démarre le sidecar — plus
# besoin de `--profile` à la main. Le plus simple : `make llm-local-enable`
# (décommente cette ligne + démarre le sidecar + télécharge un modèle par défaut).
# Coût : ~1,5 Go (image ollama) + ~2 Go (modèle, dans un volume). Laisser commenté
# pour ne pas embarquer Ollama sur un serveur qui n'en veut pas (doctrine opt-in).
# COMPOSE_PROFILES=llm-local
#
# Endpoint OpenAI-compatible du LLM local (auto-anonymisation + fallback quand le
# cloud est indisponible). Activation effective de l'USAGE dans /admin/ai-config.
# En Docker, le compose pose déjà OLLAMA_BASE_URL=http://ollama:11434/v1 (DNS du
# sidecar) : LAISSER VIDE ici dans ce cas. Ne définir que pour un Ollama sur l'HÔTE
# (ex. http://172.17.0.1:11434/v1 sur Linux) ou sur une autre machine du réseau.
OLLAMA_BASE_URL=

# =====================================================================
# Serveur SMTP (envoi des rapports par email)
# =====================================================================
# Si SMTP_USER vide : l'app refuse l'envoi de mails (les rapports
# restent disponibles dans l'app, mais ne sont pas diffusés).
SMTP_HOST=smtp.exemple.local
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@exemple.local

# =====================================================================
# Bootstrap admin (optionnel — pour `make first-run` non-interactif)
# =====================================================================
# Si ces 3 variables sont définies, scripts/seed_admin créera le premier
# compte admin sans demander de saisie. Recommandé pour automatiser un
# déploiement scripté ; les LAISSER VIDES sinon (saisie interactive).
#
# /!\ KOMPTIA_ADMIN_PASSWORD : `make first-run` la PURGE automatiquement de ce
#     fichier après le seed (et recrée le conteneur), pour qu'elle ne reste pas
#     dans l'env du container — sinon visible via `docker inspect`. Si vous
#     seedez l'admin par un autre chemin, videz la valeur manuellement après usage
#     (helper : `sh scripts/scrub_dotenv_value.sh .env KOMPTIA_ADMIN_PASSWORD`).
KOMPTIA_ADMIN_USERNAME=
KOMPTIA_ADMIN_EMAIL=
KOMPTIA_ADMIN_PASSWORD=
